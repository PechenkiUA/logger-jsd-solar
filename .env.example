# Copy to .env and fill in. The dashboard can change inverter settings: use a long password.
AUTH_USER=admin
AUTH_PASSWORD=

# monitor: readings and settings are only shown, nothing can be written to the inverter
# control: settings can also be changed from the dashboard
MODE=control

# Seconds between readings
POLL_INTERVAL=5

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token.
# Public Hostname of the tunnel must point to http://logger:8090
TUNNEL_TOKEN=
